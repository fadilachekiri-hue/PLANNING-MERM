# --- Supabase (Base de données + Comptes) ---
# Trouvés dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATTENTION : cette clé est secrète, ne jamais la mettre dans du code visible côté navigateur
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (Envoi d'e-mails) ---
RESEND_API_KEY=
# Adresse d'expédition (doit correspondre à un domaine vérifié dans Resend,
# ou "onboarding@resend.dev" pour les tests avant vérification de domaine)
EMAIL_FROM="Planning MERM <onboarding@resend.dev>"

# --- Code d'installation (première configuration uniquement) ---
# Choisissez une suite de caractères longue et unique (ex: générée sur
# https://1password.com/password-generator/). Sert une seule fois, sur la
# page /premiere-configuration, pour créer le tout premier compte
# propriétaire. Vous pouvez la changer ou la supprimer après usage.
SETUP_SECRET=

# --- Adresse publique de l'application ---
# Utilisée pour générer les liens dans les e-mails (invitation, réinitialisation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
